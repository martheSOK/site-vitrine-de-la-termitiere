/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; script-src 'self'; connect-src 'self' https://contact.latermitiere.com; frame-src 'self'; base-uri 'self'; form-action 'self';

/admin/*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com; connect-src 'self' blob: https://api.github.com https://raw.githubusercontent.com https://objects.githubusercontent.com https://oauth.latermitiere.com; frame-src 'self'; base-uri 'self'; form-action 'self';
